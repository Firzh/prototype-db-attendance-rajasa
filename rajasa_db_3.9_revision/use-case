penggunaaan pada tabel `presensi_sesi` [BE]
Untuk sesi gagal:

UPDATE `presensi_sesi`
SET
  `status` = 'gagal',
  `ended_reason` = 'system_error',
  `ended_at` = CURRENT_TIMESTAMP,
  `updated_at` = CURRENT_TIMESTAMP
WHERE `presensi_sesi_id` = :presensi_sesi_id;

Untuk koneksi terputus:

UPDATE `presensi_sesi`
SET
  `status` = 'terputus',
  `ended_reason` = 'connection_lost',
  `updated_at` = CURRENT_TIMESTAMP
WHERE `presensi_sesi_id` = :presensi_sesi_id;

Untuk pause:

UPDATE `presensi_sesi`
SET
  `status` = 'suspended',
  `updated_at` = CURRENT_TIMESTAMP
WHERE `presensi_sesi_id` = :presensi_sesi_id;

