Saat QR discan, backend cukup mencari berdasarkan payload_normalized.

SELECT
  sq.siswa_qr_id,
  sq.siswa_id,
  sq.payload_raw,
  sq.payload_normalized,
  sq.payload_nama,
  sq.payload_nisn,
  s.nama_lengkap,
  s.nisn,
  psr.rombel_id
FROM siswa_qr sq
JOIN siswa s 
  ON s.siswa_id = sq.siswa_id
LEFT JOIN penempatan_siswa_rombel psr
  ON psr.siswa_id = s.siswa_id
  AND psr.is_aktif = 1
WHERE sq.payload_normalized = ?
LIMIT 1;